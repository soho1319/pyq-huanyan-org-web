# ============================================
# pyq-huanyan-org-web .gitignore
# ============================================

# 环境变量（绝对不能提交）
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log
yarn-error.log
.pnpm-debug.log

# Quartz vendor（build 时自动 clone，**不 commit**）
vendor/

# build产物
public/
dist/

# EdgeOne
.edgeone/

# Wrangler
.wrangler/

# 系统
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# 日志
*.log
logs/

#临时文件
*.tmp
*.bak
*.bak.*

#敏感配置
*.pem
*.key
secrets/

# Obsidian vault内部文件（不要把 .obsidian提交）
.obsidian/
.trash/
